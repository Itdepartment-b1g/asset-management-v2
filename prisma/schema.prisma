generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum user_role {
  super_admin
  admin
  employee
}

enum asset_photo_kind {
  warranty
  receipt
}

enum asset_status {
  active
  inactive
  stored
}

model user {
  id            String    @id
  email         String?   @unique
  full_name     String?
  role          String?
  department_id String?
  created_by_id String?
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt

  department  departments? @relation("users_in_department", fields: [department_id], references: [id], onDelete: SetNull)
  created_by  user?        @relation("user_created_by", fields: [created_by_id], references: [id], onDelete: SetNull)
  created_users user[]     @relation("user_created_by")

  currently_issued_assets  asset_information[] @relation("current_issue")
  originally_issued_assets asset_information[] @relation("original_issue")

  transfers_from     asset_transfer[] @relation("transfer_from")
  transfers_to       asset_transfer[] @relation("transfer_to")
  transfers_recorded asset_transfer[] @relation("transfer_actor")

  created_assets      asset_information[] @relation("created_by")
  created_departments departments[]       @relation("created_by")
  created_locations   locations[]         @relation("created_by")
  created_holders     holders[]           @relation("created_by")
  created_conditions  conditions[]        @relation("created_by")
  created_legend      legend[]            @relation("created_by")
}

model asset_information {
  id                     String                 @id @default(uuid())
  asset_name             String
  code_name              String                 @unique
  serial_number          String?
  purchase_date          DateTime?
  current_condition_id   String?
  condition_assignment_id String?
  status                 asset_status?
  remarks                String?
  vendor_name            String?
  cost_value             Float?
  salvage_value          Float?
  warranty_end_date      DateTime?
  useful_life_end_date   DateTime?
  original_issue_date       DateTime?
  currently_issued_to_id    String?
  currently_issued_holder_id String?
  department_id             String?
  location_id               String?
  legend_id                 String?
  created_by_id             String?
  created_at                DateTime               @default(now())
  updated_at                DateTime               @updatedAt

  photos      asset_photo[]
  transfers   asset_transfer[]

  current_condition       conditions?  @relation("asset_current_condition", fields: [current_condition_id], references: [id], onDelete: SetNull)
  condition_assignment    conditions?  @relation("asset_condition_assignment", fields: [condition_assignment_id], references: [id], onDelete: SetNull)
  department              departments? @relation("asset_department", fields: [department_id], references: [id], onDelete: SetNull)
  location                locations?   @relation("asset_location", fields: [location_id], references: [id], onDelete: SetNull)
  legend                  legend?      @relation("asset_legend", fields: [legend_id], references: [id], onDelete: SetNull)
  currently_issued_to     user?        @relation("current_issue", fields: [currently_issued_to_id], references: [id])
  currently_issued_holder holders?     @relation("current_holder", fields: [currently_issued_holder_id], references: [id], onDelete: SetNull)
  originally_issued_to    user[]       @relation("original_issue")

  created_by user? @relation("created_by", fields: [created_by_id], references: [id])
}

model asset_photo {
  id         String           @id @default(uuid())
  asset_id   String
  kind       asset_photo_kind
  file_name  String
  mime_type  String
  byte_size  Int
  data       Bytes
  created_at DateTime         @default(now())

  asset asset_information @relation(fields: [asset_id], references: [id], onDelete: Cascade)

  @@unique([asset_id, kind])
  @@index([asset_id])
}

model asset_transfer {
  id                 String   @id @default(uuid())
  asset_id           String
  from_user_id       String?
  to_user_id         String?
  from_holder_id     String?
  to_holder_id       String?
  from_location_id   String?
  to_location_id     String?
  remarks            String?
  transferred_by_id  String
  transferred_at     DateTime @default(now())

  asset           asset_information @relation(fields: [asset_id], references: [id], onDelete: Cascade)
  from_user       user?             @relation("transfer_from", fields: [from_user_id], references: [id], onDelete: SetNull)
  to_user         user?             @relation("transfer_to", fields: [to_user_id], references: [id], onDelete: Restrict)
  from_holder     holders?          @relation("transfer_from_holder", fields: [from_holder_id], references: [id], onDelete: SetNull)
  to_holder       holders?          @relation("transfer_to_holder", fields: [to_holder_id], references: [id], onDelete: Restrict)
  transferred_by  user              @relation("transfer_actor", fields: [transferred_by_id], references: [id], onDelete: Restrict)
  from_location   locations?        @relation("transfer_from_location", fields: [from_location_id], references: [id], onDelete: SetNull)
  to_location     locations?        @relation("transfer_to_location", fields: [to_location_id], references: [id], onDelete: SetNull)

  @@index([asset_id, transferred_at])
}

model departments {
  id String @id @default(uuid())
  name String @unique
  created_by_id String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  assets            asset_information[] @relation("asset_department")
  users             user[]              @relation("users_in_department")
  created_by        user?               @relation("created_by", fields: [created_by_id], references: [id])
}

model locations {
  id String @id @default(uuid())
  name String
  created_by_id String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  assets asset_information[] @relation("asset_location")
  transfers_from asset_transfer[] @relation("transfer_from_location")
  transfers_to   asset_transfer[] @relation("transfer_to_location")
  created_by user? @relation("created_by", fields: [created_by_id], references: [id])
}

model holders {
  id            String   @id @default(uuid())
  name          String   @unique
  created_by_id String?
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  assets         asset_information[] @relation("current_holder")
  transfers_from asset_transfer[]    @relation("transfer_from_holder")
  transfers_to   asset_transfer[]    @relation("transfer_to_holder")
  created_by     user?               @relation("created_by", fields: [created_by_id], references: [id])
}

model conditions {
  id String @id @default(uuid())
  name String @unique
  created_by_id String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  current_assets       asset_information[] @relation("asset_current_condition")
  assigned_assets      asset_information[] @relation("asset_condition_assignment")
  created_by           user?               @relation("created_by", fields: [created_by_id], references: [id])
}

model legend {
  id String @id @default(uuid())
  name String
  color String
  created_by_id String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  assets asset_information[] @relation("asset_legend")
  created_by user? @relation("created_by", fields: [created_by_id], references: [id])
}
